      '      },\n' +
      '      POST: async ({ request }) => {\n' +
      '        try {\n' +
      '          // Tell the client clearly if this is running on production (not local).\n' +
      '          const local = await isLocalRuntime();\n' +
      '          if (!local) {\n' +
      '            return json(\n' +
