      '/**\n' +
      ' * Local-only historical export hook used by the marketwatch-health page.\n' +
      ' * All Supabase access inside runExport() is read-only SELECT; the only writes\n' +
      ' * are new cache partition files (never overwrite) and the browser-side save.\n' +
      ' */\n' +
      '\n' +
      'const ALLOWED = [\n' +
      '  "live_ticks",\n' +
      '  "marketwatch_snapshots",\n' +
