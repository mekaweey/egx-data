{
  "manifest_version": 3,
  "name": "Thunder Unified (v1 + CDP + Overlay)",
  "version": "4.6.2",
  "description": "v4.6.2 Ultimate Safe: تغطية 100% للسوق عبر جلب الـ API المباشر بنمط يحاكي تطبيق ثاندر تماماً لضمان الأمان.",
  "permissions": ["storage", "scripting", "tabs", "alarms", "debugger", "notifications", "offscreen"],
  "host_permissions": [
    "https://web.thndr.app/*",
    "https://*.thndr.app/*",
    "https://*.firebaseio.com/*",
    "https://*.firebasedatabase.app/*",
    "https://meky-stock.lovable.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Thunder Unified v4" },
  "content_scripts": [
    {
      "matches": ["https://web.thndr.app/*", "https://*.thndr.app/*", "https://*.firebaseio.com/*", "https://*.firebasedatabase.app/*", "https://*.lovable.app/*", "http://localhost/*"],
      "js": ["page-script.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["https://web.thndr.app/*", "https://*.thndr.app/*", "https://*.firebaseio.com/*", "https://*.firebasedatabase.app/*", "https://*.lovable.app/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["https://web.thndr.app/*", "https://*.thndr.app/*", "https://*.lovable.app/mock-thunder.html*"],
      "js": ["overlay-module.js"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-script.js"],
      "matches": ["https://web.thndr.app/*", "https://*.thndr.app/*", "https://*.firebaseio.com/*", "https://*.firebasedatabase.app/*"]
    }
  ]
}